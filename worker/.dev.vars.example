# Worker development environment variables
# Copy to .dev.vars and fill in real values
# NEVER commit .dev.vars to git

# Admin username
ADMIN_USERNAME=admin

# Admin password hash
# Generate with: node ../scripts/generate-hash.js
# Format: sha256:<hex_hash>
ADMIN_PASSWORD_HASH=sha256:REPLACE_WITH_YOUR_HASH

# Session secret - random 32+ character string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
