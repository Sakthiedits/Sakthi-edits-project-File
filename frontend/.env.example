# Frontend environment variables
# Copy to .env and fill in values
# VITE_ prefix required for Vite to expose variables to the browser

# API base URL - leave empty to use relative /api path (works with Vite proxy during development)
# Only set this if deploying the frontend and worker on different domains
# VITE_API_BASE_URL=https://sakthiedits-api.yourname.workers.dev
